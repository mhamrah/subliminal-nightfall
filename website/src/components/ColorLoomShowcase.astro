---
const terminalCommands = [
  { text: '$ colorloom generate', delay: 0 },
  { text: 'Generated themes for 5 targets', delay: 500 },
  { text: '  ✓ zed/themes/subliminal-nightfall.json (3 variants)', delay: 1000 },
  { text: '  ✓ cursor/themes/subliminal-nightfall-color-theme.json', delay: 1500 },
  { text: '  ✓ cursor/themes/subliminal-nightfall-color-theme-hazy.json', delay: 2000 },
  { text: '  ✓ cursor/themes/subliminal-nightfall-color-theme-cloudy.json', delay: 2500 },
  { text: '  ✓ neovim/colors/subliminal-nightfall.lua', delay: 3000 },
  { text: '  ✓ ghostty/subliminal-nightfall', delay: 3500 },
  { text: '  ✓ website/src/data/palette.json', delay: 4000 },
];

const outputFiles = [
  { name: 'Zed', icon: '⚡', file: 'subliminal-nightfall.json', variants: '3 variants', color: 'sn-cyan' },
  { name: 'VS Code / Cursor', icon: '📝', file: '*.json', variants: '3 files', color: 'sn-blue' },
  { name: 'Neovim', icon: '🌙', file: '*.lua', variants: '3 files', color: 'sn-green' },
  { name: 'Ghostty', icon: '👻', file: 'subliminal-nightfall*', variants: '3 files', color: 'sn-magenta' },
];

const variants = [
  { name: 'Base', opacity: '100%', blur: 'No', appearance: 'opaque' },
  { name: 'Hazy', opacity: '75%', blur: 'Yes', appearance: 'blurred' },
  { name: 'Cloudy', opacity: '90%', blur: 'Yes', appearance: 'blurred' },
];
---

<section id="colorloom" class="container mx-auto px-4 py-20">
    <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-sn-fg mb-4">ColorLoom Theme Generator</h2>
        <p class="text-sn-fg-muted text-lg max-w-2xl mx-auto mb-6">
            A powerful Rust CLI for generating consistent color themes across multiple editors and terminals from a single <code class="text-sn-cyan">theme.toml</code> configuration.
        </p>
        <a
            href="https://github.com/mhamrah/subliminal-nightfall/tree/main/tools/colorloom"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-4 py-2 bg-sn-bg-alt hover:bg-sn-bg-elevated text-sn-fg border border-sn-border hover:border-sn-cyan rounded-lg font-medium text-sm transition-all duration-200"
        >
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
            </svg>
            View on GitHub
        </a>
    </div>

    <div class="max-w-6xl mx-auto">
        <!-- Pinned container for scroll animation -->
        <div class="colorloom-pinned-container">
            <!-- Terminal Output -->
            <div class="mb-12">
                <div class="bg-sn-bg border border-sn-border rounded-lg overflow-hidden shadow-2xl">
                    <div class="flex items-center justify-between px-4 py-3 bg-sn-header-translucent border-b border-sn-border-subtle">
                        <div class="flex items-center space-x-2">
                            <div class="flex space-x-1.5">
                                <div class="w-3 h-3 rounded-full bg-sn-red" />
                                <div class="w-3 h-3 rounded-full bg-sn-yellow" />
                                <div class="w-3 h-3 rounded-full bg-sn-green" />
                            </div>
                            <span class="text-sm text-sn-fg-muted ml-4 font-mono">Terminal</span>
                        </div>
                    </div>
                    <div class="p-6 font-mono text-sm">
                        <div id="terminal-output" class="space-y-1">
                            <!-- Terminal output will be animated here -->
                        </div>
                        <div class="flex items-center mt-4">
                            <span class="text-sn-cyan">$</span>
                            <span class="ml-2 text-sn-fg" id="terminal-cursor">█</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Config Preview and Output Files -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Config Preview -->
                <div class="bg-sn-box border border-sn-border rounded-lg overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3 bg-sn-header-translucent border-b border-sn-border-subtle">
                        <div class="flex items-center space-x-2">
                            <div class="flex space-x-1.5">
                                <div class="w-3 h-3 rounded-full bg-sn-red" />
                                <div class="w-3 h-3 rounded-full bg-sn-yellow" />
                                <div class="w-3 h-3 rounded-full bg-sn-green" />
                            </div>
                            <span class="text-sm text-sn-fg-muted ml-4 font-mono">theme.toml</span>
                        </div>
                    </div>
                    <div class="p-4 overflow-x-auto">
                        <pre class="text-xs font-mono text-sn-fg"><code id="config-preview">[meta]
name = "Subliminal Nightfall"
author = "Michael Hamrah"

[palette.base.ansi.red]
base = "#bf616a"
bright = "#e2848d"
dim = "#85434a"

[palette.syntax]
teal = "#9ccfd8"
blue_green = "#31748f"
lavender = "#c4a7e7"</code></pre>
                    </div>
                </div>

                <!-- Output Files -->
                <div>
                    <h3 class="text-xl font-semibold text-sn-fg mb-4">Generated Files</h3>
                    <div class="space-y-4" id="output-files-container">
                        {outputFiles.map((file, index) => (
                            <div
                                class="bg-sn-box border border-sn-border rounded-lg p-4 hover:border-sn-cyan transition-colors output-file-card"
                                data-index={index}
                                style="opacity: 0; transform: translateY(20px);"
                            >
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-3">
                                        <span class="text-2xl">{file.icon}</span>
                                        <div>
                                            <h4 class="text-lg font-semibold text-sn-fg">{file.name}</h4>
                                            <div class="flex items-center space-x-2">
                                                <code class="text-sm text-sn-fg-muted font-mono">{file.file}</code>
                                                <span class="text-xs text-sn-cyan">({file.variants})</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class={`w-3 h-3 rounded-full bg-${file.color}`}></div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Variants Table -->
            <div class="mt-12">
                <h3 class="text-xl font-semibold text-sn-fg mb-4">Theme Variants</h3>
                <div class="bg-sn-box border border-sn-border rounded-lg overflow-hidden">
                    <table class="w-full text-left">
                        <thead class="bg-sn-bg-alt border-b border-sn-border">
                            <tr>
                                <th class="px-6 py-3 text-sm font-semibold text-sn-fg">Variant</th>
                                <th class="px-6 py-3 text-sm font-semibold text-sn-fg">Opacity</th>
                                <th class="px-6 py-3 text-sm font-semibold text-sn-fg">Blur Effect</th>
                                <th class="px-6 py-3 text-sm font-semibold text-sn-fg">Appearance</th>
                            </tr>
                        </thead>
                        <tbody>
                            {variants.map((variant, index) => (
                                <tr class={index !== variants.length - 1 ? "border-b border-sn-border" : ""}>
                                    <td class="px-6 py-4 text-sn-fg font-medium">{variant.name}</td>
                                    <td class="px-6 py-4 text-sn-fg-muted">{variant.opacity}</td>
                                    <td class="px-6 py-4">
                                        <span class={`inline-flex items-center px-2 py-1 rounded text-xs font-medium ${variant.blur === 'Yes' ? 'bg-sn-cyan/20 text-sn-cyan' : 'bg-sn-fg-dim/20 text-sn-fg-muted'}`}>
                                            {variant.blur}
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <code class="text-sm text-sn-lavender font-mono">{variant.appearance}</code>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Installation Instructions -->
            <div class="mt-12 bg-gradient-to-br from-sn-blue-green/20 to-sn-cyan/20 border border-sn-cyan/50 rounded-2xl p-8">
                <h3 class="text-2xl font-semibold text-sn-fg mb-4">Get Started</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="text-lg font-medium text-sn-cyan mb-2">Install</h4>
                        <code class="block bg-sn-bg-alt border border-sn-border rounded p-3 text-sm font-mono text-sn-fg">
                            cargo install colorloom
                        </code>
                    </div>
                    <div>
                        <h4 class="text-lg font-medium text-sn-cyan mb-2">Generate</h4>
                        <code class="block bg-sn-bg-alt border border-sn-border rounded p-3 text-sm font-mono text-sn-fg">
                            colorloom generate
                        </code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap, ScrollTrigger } from '../lib/gsap/init';

    // Animate terminal output
    function animateTerminal() {
        const terminalOutput = document.getElementById('terminal-output');
        const cursor = document.getElementById('terminal-cursor');
        if (!terminalOutput || !cursor) return;

        const commands = [
            { text: '$ colorloom generate', delay: 0 },
            { text: 'Generated themes for 5 targets', delay: 500 },
            { text: '  ✓ zed/themes/subliminal-nightfall.json (3 variants)', delay: 1000 },
            { text: '  ✓ cursor/themes/subliminal-nightfall-color-theme.json', delay: 1500 },
            { text: '  ✓ cursor/themes/subliminal-nightfall-color-theme-hazy.json', delay: 2000 },
            { text: '  ✓ cursor/themes/subliminal-nightfall-color-theme-cloudy.json', delay: 2500 },
            { text: '  ✓ neovim/colors/subliminal-nightfall.lua', delay: 3000 },
            { text: '  ✓ ghostty/subliminal-nightfall', delay: 3500 },
            { text: '  ✓ website/src/data/palette.json', delay: 4000 },
        ];

        // Animate cursor blink
        gsap.to(cursor, {
            opacity: 0,
            duration: 0.5,
            repeat: -1,
            yoyo: true,
            ease: 'power1.inOut',
        });

        // Type out commands
        commands.forEach((cmd, index) => {
            setTimeout(() => {
                const line = document.createElement('div');
                line.className = 'text-sn-fg';
                line.textContent = cmd.text;
                line.style.opacity = '0';
                terminalOutput.appendChild(line);
                
                gsap.to(line, {
                    opacity: 1,
                    duration: 0.3,
                    ease: 'power2.out',
                });
            }, cmd.delay);
        });
    }

    // Animate output file cards
    function animateOutputFiles() {
        const cards = document.querySelectorAll('.output-file-card');
        cards.forEach((card, index) => {
            gsap.to(card, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                delay: 5 + index * 0.2,
                ease: 'power3.out',
            });
        });
    }

    // Initialize on scroll into view
    ScrollTrigger.create({
        trigger: '#colorloom',
        start: 'top 80%',
        onEnter: () => {
            animateTerminal();
            animateOutputFiles();
        },
        once: true,
    });
</script>

