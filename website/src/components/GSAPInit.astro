---
// Client-side component to initialize GSAP animations
---

<script>
  import { initAnimations } from '../lib/gsap/client-init.ts';
  
  // Initialize immediately when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }
</script>

